# Local environment for running the API and the arq worker (decision 0035).
# Copy this file to `.env` in this directory (apps/api/.env) and fill in the
# values. `.env` is gitignored: never commit real keys. Loaded automatically on
# app import for real runs, and skipped under the test suite (recorded mocks).
# A real environment variable always overrides the value here.

# Model provider keys. Needed only for live runs (the worker, and the retrieval
# query embed on the API); the test suite uses recorded responses and needs
# neither. Anthropic drives handwriting transcription, PDF segmentation, and
# figure detection; OpenAI drives retrieval embeddings.
TIRO_ANTHROPIC_API_KEY=
TIRO_OPENAI_API_KEY=

# Speech providers for the voice defence (decision 0044). Both are optional:
# with neither set, a defence runs as a typed session with caption replies,
# which is the same loop and the graceful-degradation floor. Set the provider
# name to switch a deployment on, and the key beside it.
# TIRO_STT_PROVIDER=deepgram-flux
# TIRO_DEEPGRAM_API_KEY=
# TIRO_TTS_PROVIDER=cartesia-sonic
# TIRO_CARTESIA_API_KEY=
# The synthesis voice id, and the endpoint your Cartesia account's regional
# deployment gives you (the default URL is their global one; recognition
# already defaults to Deepgram's EU endpoint).
# TIRO_CARTESIA_VOICE=
# TIRO_CARTESIA_URL=wss://api.cartesia.ai/tts/websocket

# Optional model overrides (sensible defaults ship in code; leave unset to use
# them). Uncomment to pin a specific model. Defaults are current Anthropic
# snapshots (claude-sonnet-5 for authoring, claude-haiku-4-5 for the tutor);
# the retired claude-3-5-* ids 404 (decision 0070).
# TIRO_VISION_MODEL_ID=
# TIRO_SEGMENTATION_MODEL_ID=
# TIRO_PROPOSAL_MODEL_ID=
# TIRO_GENERATION_MODEL_ID=
# TIRO_VERIFICATION_MODEL_ID=
# TIRO_ASSESSMENT_MODEL_ID=
# TIRO_EMBEDDING_MODEL_ID=
# TIRO_TUTOR_MODEL_ID=
# TIRO_RUBRIC_MODEL_ID=

# Optional provider rates for the cost half of course reporting (milestone
# 8.3). No prices ship in code: without these the reports carry real usage and
# a null cost, and say so. Model rates are per million tokens; speech rates are
# per unit of whatever speech_usage records for that kind (seconds for
# recognition, characters for synthesis).
# TIRO_MODEL_PRICES={"claude-sonnet-5":{"input_per_mtok":3.0,"output_per_mtok":15.0}}
# TIRO_SPEECH_PRICES={"defense_stt":0.0043,"defense_tts":0.00002}

# Observability (milestone 8.5). With no endpoint set the SDK still creates
# spans and drops them, so dev and production run the same code paths and the
# four dashboards are simply dark. Point this at an OTLP/HTTP collector to turn
# traces, metrics, and the dashboards on.
# TIRO_OTEL_ENDPOINT=http://localhost:4318
# TIRO_OTEL_SERVICE_NAME=tirocinium-api
# TIRO_LOG_LEVEL=INFO

# Optional runtime overrides (defaults work for local dev with the compose
# stack). Uncomment only to change them.
# TIRO_DATA_DIR=data
# TIRO_REDIS_URL=redis://localhost:6379
# TIRO_JWT_SECRET=
# S3 / MinIO seam (defaults target the compose MinIO on :9000).
# TIRO_S3_ENDPOINT=http://localhost:9000
# TIRO_S3_ACCESS_KEY=tirocinium
# TIRO_S3_SECRET_KEY=tirocinium-dev
