{
  "components": {
    "schemas": {
      "AuthOut": {
        "properties": {
          "professor": {
            "$ref": "#/components/schemas/ProfessorOut"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "professor"
        ],
        "title": "AuthOut",
        "type": "object"
      },
      "CourseIn": {
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "CourseIn",
        "type": "object"
      },
      "CourseOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "title": "CourseOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "description": "Liveness of the API process itself; no dependencies are probed.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "Identity": {
        "description": "Who is calling, as resolved by the dependency layer. Professors and\nadmins carry user_id and email; seat identities carry course and seat\ncontext instead and never anything about a person.",
        "properties": {
          "course_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "seat_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seat Id"
          },
          "seat_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seat Number"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "required": [
          "role"
        ],
        "title": "Identity",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Problem": {
        "description": "The error body, also referenced from route response annotations so\nthe contract documents error shapes.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProfessorOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "ProfessorOut",
        "type": "object"
      },
      "RedeemIn": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "RedeemIn",
        "type": "object"
      },
      "RedeemOut": {
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "course_title": {
            "title": "Course Title",
            "type": "string"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "seat_number",
          "course_id",
          "course_title"
        ],
        "title": "RedeemOut",
        "type": "object"
      },
      "ReissueOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "string"
          }
        },
        "required": [
          "seat_number",
          "code"
        ],
        "title": "ReissueOut",
        "type": "object"
      },
      "RevokeOut": {
        "properties": {
          "seat_number": {
            "title": "Seat Number",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "seat_number",
          "status"
        ],
        "title": "RevokeOut",
        "type": "object"
      },
      "Role": {
        "enum": [
          "professor",
          "admin",
          "seat"
        ],
        "title": "Role",
        "type": "string"
      },
      "SeatBatchIn": {
        "properties": {
          "count": {
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          }
        },
        "required": [
          "count"
        ],
        "title": "SeatBatchIn",
        "type": "object"
      },
      "SeatBatchOut": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "csv_url": {
            "title": "Csv Url",
            "type": "string"
          },
          "pdf_url": {
            "title": "Pdf Url",
            "type": "string"
          }
        },
        "required": [
          "count",
          "csv_url",
          "pdf_url"
        ],
        "title": "SeatBatchOut",
        "type": "object"
      },
      "SeatListOut": {
        "properties": {
          "seats": {
            "items": {
              "$ref": "#/components/schemas/SeatOut"
            },
            "title": "Seats",
            "type": "array"
          }
        },
        "required": [
          "seats"
        ],
        "title": "SeatListOut",
        "type": "object"
      },
      "SeatMeOut": {
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "course_title": {
            "title": "Course Title",
            "type": "string"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "string"
          }
        },
        "required": [
          "seat_number",
          "course_id",
          "course_title"
        ],
        "title": "SeatMeOut",
        "type": "object"
      },
      "SeatOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "submission_count": {
            "title": "Submission Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "seat_number",
          "status",
          "last_used_at",
          "submission_count"
        ],
        "title": "SeatOut",
        "type": "object"
      },
      "SignupIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignupIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
