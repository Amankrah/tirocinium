{
  "name": "tirocinium-web",
  "private": true,
  "description": "Tirocinium frontend: Next.js 15 App Router, TypeScript strict, Tailwind v4 on the token layer. Specified by docs/frontend-development-guide.md; consumes the typed client generated from the backend's openapi.json (contract seam, decision 0003).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "generate:client": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.ts"
  },
  "dependencies": {
    "next": "15",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "9",
    "eslint-config-next": "15",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
