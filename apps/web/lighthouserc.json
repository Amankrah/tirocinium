{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3101",
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/enter",
        "http://localhost:3101/sign-in"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 174080 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
