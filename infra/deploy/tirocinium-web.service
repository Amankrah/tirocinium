[Unit]
Description=Tirocinium web
After=network-online.target tirocinium-api.service
Wants=network-online.target

[Service]
Type=exec
User=tirocinium
Group=tirocinium
WorkingDirectory=/opt/tirocinium/app/apps/web
# Server-only: every authed call goes through a Server Component or a server
# action, so the seat and professor tokens never reach client JavaScript
# (decision 0011). The one exception is the defence WebSocket, which the
# browser opens against the public origin (decision 0045).
Environment=NODE_ENV=production
Environment=PORT=3000
# The public origin, not 127.0.0.1, and this is load bearing. Server-side
# fetches would be happy with the loopback, but lib/api/defence.ts derives the
# defence WebSocket URL from this same value and hands it to the browser
# (decision 0045 puts that socket on the public origin, because a browser can
# set no header on a WebSocket). Point this at the loopback and every student
# is told to open a socket against their own machine. Server-to-server calls
# therefore go out through Caddy and back, which on one box is a local hop.
Environment=API_BASE_URL=https://tirocinium.sasellab.com
ExecStart=/opt/tirocinium/app/apps/web/node_modules/.bin/next start
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
