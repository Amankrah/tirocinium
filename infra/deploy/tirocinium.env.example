# Production environment for tirocinium.sasellab.com (decision 0091).
# Copy to /etc/tirocinium/tirocinium.env, fill in, and chmod 600. Never commit
# a filled copy: every value below the first block is a credential.

# ---------------------------------------------------------------- deployment
TIRO_DATA_DIR=/var/lib/tirocinium/data
# Empty means real AWS: boto3 picks the regional endpoint and the virtual
# hosted addressing style S3 expects. Set this only to point at a
# MinIO-compatible server, which needs path-style addressing instead.
TIRO_S3_ENDPOINT=
TIRO_S3_REGION=ca-central-1
TIRO_SCANS_BUCKET=tirocinium-scans
TIRO_IMPORTS_BUCKET=tirocinium-imports
TIRO_ARTIFACT_BUCKET=tirocinium-artifacts
TIRO_REDIS_URL=redis://127.0.0.1:6379
TIRO_PDFIUM_LIB=/opt/tirocinium/pdfium/lib/libpdfium.so

# Only this address may create an account. Everyone else gets a 403 from
# /auth/signup and an honest line on the page. Closing the door does not
# revoke a key: the account, once made, keeps signing in whatever this says.
TIRO_SIGNUP_ALLOWLIST=ebenezer.kwofie@mcgill.ca

# The variant pool's target per published, parameterized case study. BREE 216
# ships with its pool already built, so this only matters for new content.
TIRO_VARIANT_POOL_TARGET=10

# ---------------------------------------------------------------- credentials
# openssl rand -hex 32
TIRO_JWT_SECRET=

# The instance role should carry S3 access instead of these two. Set them only
# if you are not using an instance profile.
TIRO_S3_ACCESS_KEY=
TIRO_S3_SECRET_KEY=

TIRO_ANTHROPIC_API_KEY=
TIRO_OPENAI_API_KEY=

# Speech is optional. With neither set, a defence runs as a typed session with
# caption replies, which is the same loop and the designed floor.
# TIRO_STT_PROVIDER=deepgram-flux
# TIRO_DEEPGRAM_API_KEY=
# TIRO_TTS_PROVIDER=cartesia-sonic
# TIRO_CARTESIA_API_KEY=

# ------------------------------------------------------------------- models
TIRO_VISION_MODEL_ID=claude-sonnet-5
TIRO_SEGMENTATION_MODEL_ID=claude-sonnet-5
TIRO_PROPOSAL_MODEL_ID=claude-sonnet-5
TIRO_GENERATION_MODEL_ID=claude-opus-5
TIRO_VERIFICATION_MODEL_ID=claude-opus-5
TIRO_ASSESSMENT_MODEL_ID=claude-sonnet-5
TIRO_TUTOR_MODEL_ID=claude-haiku-4-5
TIRO_RUBRIC_MODEL_ID=claude-sonnet-5
