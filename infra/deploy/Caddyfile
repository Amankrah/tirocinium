# TLS, and the one hostname this deployment answers to.
#
# Caddy terminates HTTPS and splits by path: the API owns /api, and Next owns
# everything else. They share an origin deliberately. The seat and professor
# tokens are httpOnly cookies (decision 0011) and the defence WebSocket is
# opened by the browser against this same origin (decision 0045), so a split
# origin would mean CORS on every call and a cookie that does not travel.
tirocinium.sasellab.com {
	encode zstd gzip

	# The API, including the defence WebSocket. Caddy upgrades automatically;
	# the long read timeout is for that socket, which stays open for the
	# length of a spoken defence, and for SSE, which streams until the
	# submission reaches a terminal state.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 1h
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
