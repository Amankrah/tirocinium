# Golden-file corpora are project assets that grow deliberately and live in the
# repo via Git LFS (phases doc, "Standing practices for every phase"). These
# filters are wired now; run `git lfs install` when the first corpus lands
# (the 30-scan corpus in Phase 3.2, the five-PDF corpus in Phase 4). No matching
# files exist yet, so nothing is stored in LFS until then.
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.heic  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text

# Shell scripts stay LF even on Windows checkouts so infra/*.sh runs in CI.
*.sh    text eol=lf
